APP_NAME=Dukkani
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dukkani-prod.onrender.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_JO
APP_TIMEZONE=Asia/Amman
TZ=Asia/Amman

DEMO_MODE=false
DEMO_SEED=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Neon Postgres (Frankfurt). Use either DB_URL or the individual DB_* values.
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx.aws-eu-central-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# Cloudinary images. Copy the API environment variable from the Cloudinary console.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dukkani.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Dukkani social publishing — copy to social/.env and fill in.
# NEVER commit social/.env (it is gitignored).

# ---------------------------------------------------------------------------
# Meta (Facebook Page + Instagram) — one app covers both
# ---------------------------------------------------------------------------
# Which Graph API version to call. Bump if Meta sunsets this one.
META_GRAPH_VERSION=v23.0

# Meta app credentials (developers.facebook.com/apps → your app → Settings → Basic).
# Used by `node social/meta-auth.mjs` to turn a short-lived token into a
# long-lived one and auto-fill the ids below.
META_APP_ID=
META_APP_SECRET=

# Optional: if you admin more than one Page, the exact name to pick.
META_PAGE_NAME=

# Facebook Page ID (Page → About → Page ID, or from the Graph API explorer).
# auto-filled by `node social/meta-auth.mjs`.
FB_PAGE_ID=

# Long-lived Page access token (60 days). Permissions:
#   pages_manage_posts, pages_read_engagement, pages_show_list
FB_PAGE_ACCESS_TOKEN=

# Instagram Business/Creator account ID, linked to the Page above.
# Must be an IG *professional* account. Permissions:
#   instagram_basic, instagram_content_publish, business_management
IG_USER_ID=

# Meta *user* token. Paste the SHORT-LIVED token from the Graph API Explorer here
# and run `node social/meta-auth.mjs`; it exchanges it for a long-lived token and
# overwrites this line. Also read by `whoami`.
META_USER_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# LinkedIn (personal profile)
# ---------------------------------------------------------------------------
# OAuth 2.0 access token (60 days), scope w_member_social (plus openid profile
# so `whoami` can detect your member URN).
LINKEDIN_ACCESS_TOKEN=

# Optional. If empty, the script reads it from the token via /v2/userinfo.
# Format: urn:li:person:XXXXXXXX
LINKEDIN_AUTHOR_URN=

# Versioned API header (YYYYMM). Bump if LinkedIn sunsets this one.
LINKEDIN_VERSION=202610

# Client credentials, used only by `node social/linkedin-auth.mjs`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Instagram media hosting
# ---------------------------------------------------------------------------
# Instagram downloads media from a PUBLIC URL, it cannot read your disk.
# Deploy the landing site with `node social/publish.mjs stage` (copies the
# images into dukkani-landing/social/) and point this at that folder.
# Example: https://dukkani.example.com/social
PUBLIC_MEDIA_BASE_URL=

# Optional comma-separated override of the Instagram carousel image URLs,
# in order. Takes precedence over PUBLIC_MEDIA_BASE_URL.
IG_IMAGE_URLS=
